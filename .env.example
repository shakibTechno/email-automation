# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/email_automation
# Alternative for development: DATABASE_URL=sqlite:///db.sqlite3

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery (uses Redis as broker)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Frontend URL (for embed codes and public form links)
FRONTEND_URL=http://localhost:3000

# Backend URL (for public landing pages)
BACKEND_URL=http://localhost:8000

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production with AWS SES:
# EMAIL_BACKEND=anymail.backends.amazon_ses.EmailBackend
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_SES_REGION_NAME=us-east-1
# AWS_SES_REGION_ENDPOINT=email.us-east-1.amazonaws.com

# Default From Email
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
SERVER_EMAIL=admin@yourdomain.com

# Security Settings
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Password Reset
PASSWORD_RESET_TIMEOUT=3600

# Rate Limiting (Django Axes)
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1

# Logging
LOG_LEVEL=INFO


# ── Production deployment (docker-compose.prod.yml) ──────────────────────────
# Public hostname Caddy obtains a TLS certificate for. Must already have an A
# record pointing at this server, or the certificate request fails.
APP_HOST=app.example.com

# Django rejects HTTPS POSTs whose Origin is not listed, so behind a proxy this
# must name the public origin or admin logins fail CSRF.
CSRF_TRUSTED_ORIGINS=https://app.example.com

# Tracking pixels, click-wrapped links and unsubscribe URLs are built from
# BASE_URL and embedded in every message sent, so a wrong value here is only
# discovered after mail has gone out.
BASE_URL=https://app.example.com

# Credentials for the postgres service. Change POSTGRES_PASSWORD before
# deploying anywhere the port is reachable.
POSTGRES_DB=email_automation
POSTGRES_USER=email_automation
POSTGRES_PASSWORD=change-me

# ── Postal mail server (see mailstack/) ──────────────────────────────────────
# Off by default: with POSTAL_ENABLED=False every organization keeps using the
# SMTP paths and nothing below is read.
POSTAL_ENABLED=False
# The Postal server that accepts sends and signs webhooks.
POSTAL_URL=https://mail.yourdomain.com
# The provisioning API that creates one mail server per organization, and its
# bearer token (printed by install.sh, also in /opt/mailstack/provisioner.env).
POSTAL_PROVISIONER_URL=https://api.mail.yourdomain.com
POSTAL_PROVISIONER_TOKEN=
# Leave True. Setting it False disables the RSA signature check that stops
# anyone forging delivery events by POSTing to the public webhook endpoint.
POSTAL_WEBHOOK_VERIFY=True
# Per-tenant hourly cap = plan allowance x this. Postal *holds* mail above the
# cap for manual release, so it is a circuit breaker, not a throttle.
POSTAL_SEND_LIMIT_MULTIPLIER=2
