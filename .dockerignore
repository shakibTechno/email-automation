# ---- Version control / editors ----
.git
.gitignore
.claude
.vscode
.idea

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/
.coverage
htmlcov/
.tox/
*.egg-info/
.mypy_cache/

# ---- Secrets & local env ----
