.env
.env.*
!.env.example

# ---- Local data (lives in named volumes instead) ----
db.sqlite3
*.sqlite3
celerybeat-schedule*
logs/
media/
staticfiles/

# ---- Frontend (built by its own image / build context) ----
frontend/

# ---- Docs & scratch ----
*.md
docs/
nul
debug_auth.html
