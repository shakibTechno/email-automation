# ---------------------------------------------------------------------------
# Container-only overrides. Loaded AFTER .env by docker compose, so everything
# here wins over the host-oriented values in .env (localhost / WSL IPs), while
# secrets such as the SMTP password keep coming from .env alone.
# ---------------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=config.settings.development

# SQLite lives on a named volume shared by backend, worker and beat.
# Note the four slashes: sqlite://// + absolute path.
# PostgreSQL. The host is the compose service name.
# To fall back to SQLite for a throwaway run:
#   DATABASE_URL=sqlite:////app/data/db.sqlite3
DATABASE_URL=postgres://email_automation:email_automation@postgres:5432/email_automation

# Consumed by the postgres service itself; keep in step with DATABASE_URL.
POSTGRES_DB=email_automation
POSTGRES_USER=email_automation
POSTGRES_PASSWORD=email_automation

# Service-name DNS inside the compose network, not the WSL bridge IP.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# nginx forwards the original Host header, so add the container names too.
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,0.0.0.0,192.168.100.41

# The whole app is reachable through the frontend origin; the backend port is
# published as well for direct API access and the Django admin.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://192.168.100.41:3000,http://192.168.100.41:8000,http://192.168.100.41:5173
