# Normalise line endings in the repository to LF.
#
# Without this, files committed from Windows carry CRLF and every checkout on
# Linux or macOS shows the whole tree as modified. Git stores LF and converts
# to the platform's native ending on checkout.
* text=auto eol=lf

# Shell scripts and Dockerfiles must be LF even on Windows checkouts — CRLF
# breaks shebang lines inside containers with "bad interpreter: no such file".
*.sh            text eol=lf
*.bash          text eol=lf
Dockerfile*     text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
entrypoint*     text eol=lf

# Batch files are the opposite: they need CRLF to run on Windows.
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Binary files — never convert, never diff as text.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.webp          binary
*.pdf           binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.eot           binary
*.sqlite3       binary
*.db            binary

# Generated files: keep them out of diffs and language statistics.
package-lock.json   linguist-generated=true -diff
*.min.js            linguist-generated=true -diff
*.min.css           linguist-generated=true -diff
